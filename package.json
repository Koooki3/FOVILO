{
  "name": "fovilo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/unit.test.mjs",
    "test:browser": "npm run build && node --test tests/browser.test.mjs",
    "test:live": "npm run build && node --test tests/live-watch.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "esbuild": "0.28.0",
    "playwright-core": "1.58.2"
  }
}
