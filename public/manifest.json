{
  "manifest_version": 3,
  "name": "FOVILO (Development)",
  "version": "0.0.1",
  "description": "A reversible YouTube Watch enhancement.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ]
}
